# ==============================================================================
# Bramhkanti Storefront Environment Configuration (.env.example)
#
# Copy this file to .env.local for local development.
# Only NEXT_PUBLIC_* variables are exposed to the client browser.
# All other variables are strictly server-only.
# ==============================================================================

# --- Server: Runtime & Backend Adapter ---
NODE_ENV=development

# Adapter selection: 'mock' (default) | 'medusa'
API_ADAPTER=mock

# Medusa v2 Backend Configuration (required only when API_ADAPTER=medusa)
API_BASE_URL=https://api.bramhkanti.com
MEDUSA_PUBLISHABLE_KEY=pk_test_sample_publishable_key
# Optional: fixed region id (reg_...). Leave empty to use the backend's INR region.
MEDUSA_REGION_ID=

# HTTP Client Resiliency
API_TIMEOUT_MS=8000
API_MAX_RETRIES=2

# Cache Invalidation Security (min 32 characters; used by POST /api/revalidate)
# Generate via: openssl rand -hex 32
REVALIDATE_SECRET=change_me_to_at_least_32_hex_chars_secret_for_revalidation

# Error Tracking & Build Metadata
SENTRY_DSN=
BUILD_VERSION=0.1.0

# --- Public: Client-Safe Configuration (NEXT_PUBLIC_*) ---
NEXT_PUBLIC_SITE_URL=https://bramhkanti.com
NEXT_PUBLIC_BRAND_NAME=Bramhkanti
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# Compliance & Brand Contact
NEXT_PUBLIC_SUPPORT_EMAIL=support@bramhkanti.com
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_FSSAI_LICENSE_NUMBER=12345678901234

# Client Analytics & Monitoring
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
