{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3008/",
        "http://127.0.0.1:3008/achar",
        "http://127.0.0.1:3008/products/heritage-aam-ka-achar",
        "http://127.0.0.1:3008/collections/diwali-gifting",
        "http://127.0.0.1:3008/policies/shipping",
        "http://127.0.0.1:3008/hi",
        "http://127.0.0.1:3008/hi/achar"
      ],
      "startServerCommand": "pnpm next start -p 3008",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 30000,
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
